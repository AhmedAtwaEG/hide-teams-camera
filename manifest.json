{
  "manifest_version": 3,
  "name": "Hide Teams Camera",
  "version": "1.3.0",
  "description": "Hide chosen people's camera video in Microsoft Teams meetings, on your screen only.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Hide Teams Camera" },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
